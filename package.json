{
  "name": "trailguard",
  "version": "0.1.0",
  "description": "Declare, enforce, prove. Static RBAC/audit-coverage scanner plus a tamper-evident, HMAC-chained audit log for Express + Prisma + MySQL.",
  "type": "module",
  "license": "MIT",
  "author": "Dakshesh Sharma",
  "keywords": [
    "express",
    "prisma",
    "rbac",
    "audit",
    "security",
    "audit-log",
    "static-analysis"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scan": {
      "import": "./dist/scan/index.js",
      "types": "./dist/scan/index.d.ts",
      "default": "./dist/scan/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trailguard": "./bin/trailguard.js"
  },
  "files": [
    "dist",
    "bin",
    "prisma",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "demo:setup": "prisma db push --schema examples/demo-app/prisma/schema.prisma && tsx examples/demo-app/prisma/seed.ts",
    "demo:start": "tsx examples/demo-app/src/server.ts",
    "demo:break": "git apply examples/demo-app/vulnerable.patch",
    "demo:fix": "git apply -R examples/demo-app/vulnerable.patch",
    "audit": "node bin/trailguard.js ci --config examples/demo-app/trailguard.config.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jiti": "^1.21.6",
    "ts-morph": "^23.0.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@prisma/client": ">=5",
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.14.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
