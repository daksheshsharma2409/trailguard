datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  role         String   @default("STUDENT") @db.VarChar(32) // ADMIN | TEACHER | STUDENT | AUDITOR
  phone        String?  @db.VarChar(32)
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamp(3)

  @@map("User")
}

model Student {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  email     String   @unique @db.VarChar(191)
  phone     String?  @db.VarChar(32)
  marks     Int      @default(0)
  teacherId String?  @db.VarChar(191)

  @@map("Student")
}

model AuditLog {
  seq         BigInt   @id
  model       String   @db.VarChar(191)
  recordId    String   @db.VarChar(191)
  action      String   @db.VarChar(16)
  actorId     String?  @db.VarChar(191)
  actorRole   String?  @db.VarChar(64)
  requestId   String?  @db.VarChar(64)
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(512)
  payload     String   @db.Text
  before      Json?
  after       Json?
  diff        Json?
  prevHash    String   @db.Char(64)
  hash        String   @unique @db.Char(64)
  keyId       String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  @@index([model, recordId])
  @@index([actorId])
  @@index([createdAt])
  @@map("trailguard_audit_log")
}

model AuditHead {
  id        Int    @id
  lastSeq   BigInt
  lastHash  String @db.Char(64)

  @@map("trailguard_audit_head")
}
